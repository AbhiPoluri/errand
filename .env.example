# Copy to .env and fill in. The .env file is gitignored — never commit your key.

# Required: your OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-key-here

# Optional: default model (any tool-capable OpenRouter id). Switchable in-app (Settings → Model).
MODEL=deepseek/deepseek-v4-flash:nitro

# Optional: sandbox root for the file tools (defaults to ./workspace)
# WORKSPACE_ROOT=/absolute/path/to/folder

# Optional: OCR timeout in milliseconds (defaults to 45000)
# OCR_TIMEOUT_MS=45000
