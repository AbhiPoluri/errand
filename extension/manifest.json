{
  "manifest_version": 3,
  "name": "Errand Browser Helper",
  "version": "0.2.3",
  "description": "Lets Errand do tasks in your browser tabs — read pages, click, and type, with your permission.",
  "permissions": ["tabs", "scripting", "activeTab", "alarms", "storage", "tabGroups", "debugger"],
  "host_permissions": ["<all_urls>", "http://localhost:3200/*"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Errand is connected",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
