{
  "name": "agent-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A from-scratch AI agent harness over OpenRouter. Own every line.",
  "main": "electron/main.cjs",
  "scripts": {
    "v0": "tsx src/v0.ts",
    "models": "tsx src/checkModel.ts",
    "v1:test": "tsx src/v1test.ts",
    "v2:test": "tsx src/v2test.ts",
    "v3:test": "tsx src/v3test.ts",
    "loop:test": "tsx src/looptest.ts",
    "web:test": "tsx src/webtest.ts",
    "fileops:test": "tsx src/fileopsTest.ts",
    "mem:test": "tsx src/memtest.ts",
    "journal:test": "tsx src/journaltest.ts",
    "embed:test": "tsx src/server/embedtest.ts",
    "store:test": "tsx src/storetest.ts",
    "websink:test": "tsx src/server/websinktest.ts",
    "ext:test": "tsx src/exttest.ts",
    "bash:test": "tsx src/bashTest.ts",
    "clickrisk:test": "tsx src/clickrisktest.ts",
    "restart:test": "tsx src/restartTest.ts",
    "doc:test": "tsx src/docTest.ts",
    "ocr:test": "tsx src/ocrTest.ts",
    "cap:test": "tsx src/capTest.ts",
    "endpoint:test": "tsx src/endpointTest.ts",
    "zip:test": "tsx src/zipTest.ts",
    "docwrite:test": "tsx src/docWriteTest.ts",
    "mcp:test": "tsx src/mcpTest.ts",
    "mcpconfig:test": "tsx src/mcpConfigTest.ts",
    "skill:test": "tsx src/skillTest.ts",
    "migrate:test": "tsx src/migrateTest.ts",
    "seq:test": "tsx src/seqTest.ts",
    "models:test": "tsx src/modelsTest.ts",
    "userun:test": "tsx src/useRunTest.ts",
    "runroute:test": "tsx src/runRouteTest.ts",
    "paths:test": "tsx src/pathsTest.ts",
    "folders:test": "tsx src/foldersTest.ts",
    "resume:test": "tsx src/resumeTest.ts",
    "cli": "tsx src/cli.ts",
    "web": "next dev -p 3200",
    "dev": "next dev -p 3200",
    "build:web": "next build && node scripts/prepare-standalone.mjs",
    "electron": "electron .",
    "app": "npm run build:web && electron .",
    "set-key": "electron scripts/set-key.cjs",
    "dist": "npm run build:web && electron-builder --mac --dir",
    "dist:dmg": "npm run build:web && electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.abhirampoluri.errand",
    "productName": "Errand",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dir",
      "identity": null,
      "icon": "build/icon.icns"
    }
  },
  "dependencies": {
    "framer-motion": "^12.40.0",
    "geist": "^1.7.2",
    "next": "^14.2.35",
    "openai": "^4.77.0",
    "playwright-core": "^1.61.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.6.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.5.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
